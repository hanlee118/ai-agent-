NODE_ENV=development
PORT=3310

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_platform_v21
DB_USER=postgres
DB_PASS=postgres
DB_MIGRATIONS_RUN=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4.1-mini

HERMES_ENABLED=true
HERMES_MCP=http://localhost:3001/mcp
HERMES_MCP_ENDPOINT=http://localhost:3001/mcp
HERMES_FALLBACK_URL=http://localhost:3001/fallback
HERMES_API_KEY=
HERMES_TIMEOUT=180
HERMES_MEMORY_SYNC_INTERVAL=3600
HERMES_SKILL_LIBRARY_PATH=/data/hermes/skills

OPENCLAW_ENABLED=true
OPENCLAW_API=http://localhost:3002/api
OPENCLAW_API_ENDPOINT=http://localhost:3002/api
OPENCLAW_WORKSPACE_ROOT=/data/openclaw/workspaces
OPENCLAW_SYNC_INTERVAL=300

STITCH_API=http://localhost:3010/stitch

ROUTING_DEFAULT_STRATEGY=auto
ROUTING_HYBRID_COMPLEXITY_THRESHOLD=7
ROUTING_HEALTH_CHECK_INTERVAL=60

SKILL_OBSERVATION_PERIOD_HOURS=24
SKILL_AUTO_EXTRACT_THRESHOLD=7
SKILL_REFINEMENT_TRIGGER_USES=5
SKILL_MAX_VERSIONS=10
