generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentProfile {
  roleId            String   @id
  name              String
  tagline           String
  description       String
  status            String
  workload          Int
  styles            Json
  skills            Json
  recentHighlights  Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ManagedAgentConfig {
  agentId                String            @id
  displayName            String?
  title                  String?
  intro                  String?
  responsibility         String?
  selectedModel          String
  defaultModel           String
  fallbackModel          String?
  executionMode          String            @default("confirm_first")
  requireConfirmation    Boolean           @default(true)
  autoApproveMinorSteps  Boolean           @default(false)
  maxPromptTokens        Int?
  maxCompletionTokens    Int?
  maxDailyTokens         Int?
  memoryEnabled          Boolean           @default(true)
  allowedAgentIds        Json?
  toolAllowlist          Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  memoryEntries          AgentMemoryEntry[]
  usageLogs              AgentUsageLog[]
}

model AgentMemoryEntry {
  id            String             @id @default(cuid())
  agentId       String
  projectId     String?
  type          String
  summary       String
  content       String
  importance    Int                @default(50)
  tags          Json
  source        String?
  lastAccessedAt DateTime          @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  agent         ManagedAgentConfig @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, importance])
}

model AgentUsageLog {
  id               String             @id @default(cuid())
  agentId          String
  model            String
  promptTokens     Int                @default(0)
  completionTokens Int                @default(0)
  totalTokens      Int                @default(0)
  status           String
  commandType      String
  createdAt        DateTime           @default(now())
  agent            ManagedAgentConfig @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model SystemConfig {
  id                   String   @id
  provider             String   @default("scripted")
  apiBaseUrl           String   @default("")
  apiKey               String   @default("")
  modelName            String   @default("")
  executionProtocol    Json?
  adminPasswordHash    String   @default("")
  adminPasswordSalt    String   @default("")
  adminPasswordUpdatedAt DateTime?
  configSource         String   @default("default")
  lastValidatedAt      DateTime?
  lastValidationStatus String   @default("unknown")
  lastValidationError  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuthSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String
  actorLabel  String
  action      String
  resourceType String
  resourceId  String?
  summary     String
  detail      String?
  requestId   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

model NotificationState {
  id             String   @id @default(cuid())
  sourceKey      String   @unique
  sourceType     String
  severity       String
  category       String
  title          String
  detail         String
  actionLabel    String
  to             String
  eventAt        DateTime?
  isRead         Boolean  @default(false)
  assignedTo     String?
  confirmedBy    String?
  workflowStatus String   @default("open")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workflowStatus, updatedAt])
  @@index([severity, updatedAt])
}

model PromptTemplate {
  id         String   @id @default(cuid())
  title      String
  content    String
  scope      String
  channel    String
  locale     String
  projectId  String?
  ownerLabel String?
  usageCount Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([channel, locale, updatedAt])
  @@index([projectId, channel, locale])
  @@index([scope, ownerLabel, updatedAt])
}

model Project {
  id                  String          @id
  name                String
  description         String
  parsedKeywords      Json
  parsedConstraints   Json
  parsedRisks         Json
  parsedSuggestedTeam Json
  parsedSummary       String
  status              String
  currentStage        String
  progress            Int
  pendingApproval     Boolean         @default(false)
  currentRole         String
  team                Json
  summary             String
  liveTitle           String
  liveBody            String
  liveStartedAt       DateTime
  liveProvider        String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  stages              Stage[]
  tasks               Task[]
  deliverables        Deliverable[]
  timeline            TimelineEvent[]
  executions          ProjectExecution[]
}

model Stage {
  id         String   @id @default(cuid())
  projectId  String
  type       String
  label      String
  assignee   String
  status     String
  progress   Int
  sortOrder  Int
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, type])
  @@index([projectId, sortOrder])
}

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  stageType  String
  name       String
  type       String
  content    String
  version    Int
  status     String
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageType])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  projectId  String
  timestamp  DateTime
  agentId    String?
  type       String
  title      String
  content    String
  priority   String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, timestamp])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  stageType   String
  title       String
  description String
  assignee    String
  status      String
  priority    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, stageType])
  @@index([assignee, status])
}

model ProjectExecution {
  id             String   @id @default(cuid())
  projectId      String
  stageType      String
  role           String
  action         String
  status         String
  provider       String?
  model          String?
  requestedMode  String?
  runtimeMode    String?
  promptSummary  String?
  outputPreview  String?
  errorMessage   String?
  latencyMs      Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, stageType, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// Aegis OS Models
// ============================================================

model Model {
  id          String     @id @default(uuid())
  name        String
  provider    String
  apiKey      String?
  apiBaseUrl  String?
  status      String     @default("Offline")
  totalTokens Int        @default(0)
  dailyTokens Int        @default(0)
  tokenLimit  Int        @default(1000000)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        ModelLog[]
}

model ModelLog {
  id        String   @id @default(uuid())
  modelId   String
  timestamp DateTime
  type      String   // bash, json, assistant, system
  content   String
  label     String?
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model AgentSoul {
  agentId   String   @id
  content   String
  updatedAt DateTime @updatedAt
}

model AgentSop {
  agentId   String   @id
  steps     String   // JSON array of step strings
  updatedAt DateTime @updatedAt
}

model GitLabSync {
  id          String   @id @default(cuid())
  projectId   String
  issueIid    Int
  projectPath String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, issueIid])
  @@index([projectPath, status])
}
