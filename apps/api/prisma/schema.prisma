generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentProfile {
  roleId            String   @id
  name              String
  tagline           String
  description       String
  status            String
  workload          Int
  styles            Json
  skills            Json
  recentHighlights  Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ManagedAgentConfig {
  agentId                String            @id
  displayName            String?
  title                  String?
  intro                  String?
  responsibility         String?
  selectedModel          String
  defaultModel           String
  fallbackModel          String?
  executionMode          String            @default("confirm_first")
  requireConfirmation    Boolean           @default(true)
  autoApproveMinorSteps  Boolean           @default(false)
  maxPromptTokens        Int?
  maxCompletionTokens    Int?
  maxDailyTokens         Int?
  memoryEnabled          Boolean           @default(true)
  allowedAgentIds        Json?
  toolAllowlist          Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  memoryEntries          AgentMemoryEntry[]
  usageLogs              AgentUsageLog[]
}

model AgentMemoryEntry {
  id            String             @id @default(cuid())
  agentId       String
  projectId     String?
  type          String
  summary       String
  content       String
  importance    Int                @default(50)
  tags          Json
  source        String?
  lastAccessedAt DateTime          @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  agent         ManagedAgentConfig @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([agentId, importance])
}

model AgentUsageLog {
  id               String             @id @default(cuid())
  agentId          String
  model            String
  promptTokens     Int                @default(0)
  completionTokens Int                @default(0)
  totalTokens      Int                @default(0)
  status           String
  commandType      String
  createdAt        DateTime           @default(now())
  agent            ManagedAgentConfig @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model SystemConfig {
  id                   String   @id
  provider             String   @default("scripted")
  apiBaseUrl           String   @default("")
  apiKey               String   @default("")
  modelName            String   @default("")
  executionProtocol    Json?
  adminPasswordHash    String   @default("")
  adminPasswordSalt    String   @default("")
  adminPasswordUpdatedAt DateTime?
  configSource         String   @default("default")
  lastValidatedAt      DateTime?
  lastValidationStatus String   @default("unknown")
  lastValidationError  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AuthSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String?
  expiresAt   DateTime
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String
  actorLabel  String
  action      String
  resourceType String
  resourceId  String?
  summary     String
  detail      String?
  requestId   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
}

model NotificationState {
  id             String   @id @default(cuid())
  sourceKey      String   @unique
  sourceType     String
  severity       String
  category       String
  title          String
  detail         String
  actionLabel    String
  to             String
  eventAt        DateTime?
  isRead         Boolean  @default(false)
  assignedTo     String?
  confirmedBy    String?
  workflowStatus String   @default("open")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workflowStatus, updatedAt])
  @@index([severity, updatedAt])
}

model PromptTemplate {
  id         String   @id @default(cuid())
  title      String
  content    String
  scope      String
  channel    String
  locale     String
  projectId  String?
  ownerLabel String?
  usageCount Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([channel, locale, updatedAt])
  @@index([projectId, channel, locale])
  @@index([scope, ownerLabel, updatedAt])
}

model Project {
  id                  String          @id
  name                String
  description         String
  parsedKeywords      Json
  parsedConstraints   Json
  parsedRisks         Json
  parsedSuggestedTeam Json
  parsedSummary       String
  status              String
  currentStage        String
  progress            Int
  pendingApproval     Boolean         @default(false)
  currentRole         String
  team                Json
  summary             String
  liveTitle           String
  liveBody            String
  liveStartedAt       DateTime
  liveProvider        String
  projectType         String          @default("complete")
  parentProjectId     String?
  relaySourceStageId  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  parentProject       Project?        @relation("ProjectRelayParent", fields: [parentProjectId], references: [id], onDelete: SetNull)
  childProjects       Project[]       @relation("ProjectRelayParent")
  relaySourceStage    Stage?          @relation("ProjectRelaySourceStage", fields: [relaySourceStageId], references: [id], onDelete: SetNull)
  stages              Stage[]
  tasks               Task[]
  taskParticipants    TaskParticipant[]
  taskDependencies    TaskDependency[]
  taskDelegations     TaskDelegation[]
  gitlabSyncBindings  GitLabSyncBinding[]
  deliverables        Deliverable[]
  projectInputs       ProjectInput[]
  timeline            TimelineEvent[]
  executions          ProjectExecution[]
  structuredMergeRequests StructuredMergeRequest[]
  workflows           Workflow[]
  projectMembers      ProjectMember[]
  outgoingRelayRelations StageRelayRelation[] @relation("RelaySourceProject")
  incomingRelayRelations StageRelayRelation[] @relation("RelayTargetProject")

  @@index([projectType, createdAt])
  @@index([parentProjectId])
  @@index([status, pendingApproval, updatedAt])
}

model StructuredMergeRequest {
  id            String   @id @default(cuid())
  projectId     String
  workflowStageId String?
  executionId   String?
  relatedIssue  String
  purpose       String
  changes       Json
  impact        String
  verification  String
  riskRollback  String
  rawPayload    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([workflowStageId])
  @@index([executionId])
}

model UserProfile {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  role           String          @default("viewer")
  passwordHash   String          @default("")
  passwordSalt   String          @default("")
  passwordUpdatedAt DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  authSessions   AuthSession[]
  projectMembers ProjectMember[]

  @@index([role, isActive])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      String      @default("viewer")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, role])
  @@index([projectId, role])
}

model Stage {
  id         String   @id @default(cuid())
  projectId  String
  type       String
  label      String
  assignee   String
  status     String
  progress   Int
  sortOrder  Int
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relayTargetProjects Project[] @relation("ProjectRelaySourceStage")
  sourceRelayRelations StageRelayRelation[] @relation("RelaySourceStage")

  @@unique([projectId, type])
  @@index([projectId, sortOrder])
  @@index([projectId, createdAt])
  @@index([status, updatedAt])
}

model Deliverable {
  id         String   @id @default(cuid())
  projectId  String
  stageType  String
  name       String
  type       String
  content    String
  version    Int
  status     String
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referencedByInputs ProjectInput[]

  @@index([projectId, stageType])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  projectId  String
  timestamp  DateTime
  agentId    String?
  type       String
  title      String
  content    String
  priority   String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, timestamp])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  stageType   String
  title       String
  description String
  assignee    String
  ownerAgentId String?
  reviewAgentId String?
  coordinationMode String @default("single_owner")
  delegationPolicy String @default("manual_only")
  syncPolicy String @default("db_plus_gitlab")
  contextScope String?
  parentTaskId String?
  pendingDelegationCount Int @default(0)
  lastDelegatedAt DateTime?
  status      String
  priority    String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants TaskParticipant[]
  dependencies TaskDependency[] @relation("TaskDependencies")
  blockingTasks TaskDependency[] @relation("TaskDependencyTargets")
  delegations TaskDelegation[]
  gitlabSyncBindings GitLabSyncBinding[]

  @@index([projectId, stageType])
  @@index([projectId, stageType, status])
  @@index([assignee, status])
  @@index([status, updatedAt])
  @@index([ownerAgentId, status])
  @@index([reviewAgentId, status])
  @@index([parentTaskId])
}

model TaskParticipant {
  id        String   @id @default(cuid())
  projectId String
  taskId    String
  agentId   String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId, role])
  @@index([projectId, taskId])
  @@index([agentId, role])
}

model TaskDependency {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  dependsOnTaskId String
  type            String
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("TaskDependencyTargets", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId, type])
  @@index([projectId, type])
  @@index([dependsOnTaskId, type])
}

model TaskDelegation {
  id                String   @id @default(cuid())
  projectId         String
  taskId            String
  parentExecutionId String?
  requestedByAgentId String
  targetAgentId     String?
  mode              String
  status            String
  title             String
  goal              String
  inputContextRef   String?
  inputSummary      String?
  resultSchema      String?
  outputSummary     String?
  outputPayloadJson Json?
  outputArtifactsJson Json?
  budgetTokens      Int?
  timeoutSec        Int?
  spawnDepth        Int      @default(0)
  retryCount        Int      @default(0)
  maxRetries        Int      @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  failureReason     String?
  clarificationDeliverableId String?
  clarificationTargetRole String?
  clarificationResponse String?
  clarificationRespondedBy String?
  clarificationRespondedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@index([taskId, status, createdAt])
  @@index([requestedByAgentId, createdAt])
}

model ProjectExecution {
  id             String   @id @default(cuid())
  projectId      String
  stageType      String
  role           String
  action         String
  status         String
  provider       String?
  model          String?
  requestedMode  String?
  runtimeMode    String?
  promptSummary  String?
  outputPreview  String?
  errorMessage   String?
  latencyMs      Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, stageType, createdAt])
  @@index([status, createdAt])
}

// ============================================================
// Aegis OS Models
// ============================================================

model Model {
  id          String     @id @default(uuid())
  name        String
  provider    String
  apiKey      String?
  apiBaseUrl  String?
  status      String     @default("Offline")
  totalTokens Int        @default(0)
  dailyTokens Int        @default(0)
  tokenLimit  Int        @default(1000000)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        ModelLog[]

  @@index([status, updatedAt])
}

model ModelLog {
  id        String   @id @default(uuid())
  modelId   String
  timestamp DateTime
  type      String   // bash, json, assistant, system
  content   String
  label     String?
  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, timestamp])
  @@index([modelId, type, timestamp])
}

model AgentSoul {
  agentId   String   @id
  content   String
  updatedAt DateTime @updatedAt
}

model AgentSop {
  agentId   String   @id
  steps     String   // JSON array of step strings
  updatedAt DateTime @updatedAt
}

model GitLabSync {
  id          String   @id @default(cuid())
  projectId   String
  issueIid    Int
  projectPath String
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, issueIid])
  @@index([projectPath, status])
}

model GitLabSyncBinding {
  id            String   @id @default(cuid())
  projectId     String?
  stageId       String?
  taskId        String?
  gitlabProjectId String
  issueId       String?
  issueIid      Int?
  bindingType   String
  syncPolicy    String
  lastSyncedAt  DateTime?
  lastSyncHash  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, bindingType])
  @@index([taskId, bindingType])
  @@index([gitlabProjectId, bindingType])
  @@unique([taskId, bindingType])
  @@unique([gitlabProjectId, issueIid, bindingType])
}

model KnowledgeItem {
  id                String                     @id @default(cuid())
  scope             String
  projectId         String?
  agentId           String?
  type              String
  title             String
  content           String
  contentVector     Json?
  metadata          Json
  tags              Json
  stageContext      Json
  techStack         Json
  memoryType        String?
  importanceScore   Float?
  sourceUrl         String?
  filePath          String?
  fileType          String?
  accessCount       Int                        @default(0)
  lastAccessedAt    DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  outgoingRelations KnowledgeRelation[]        @relation("KnowledgeRelationSource")
  incomingRelations KnowledgeRelation[]        @relation("KnowledgeRelationTarget")
  preferences       AgentKnowledgePreference[]

  @@index([scope, projectId])
  @@index([scope, projectId, updatedAt])
  @@index([createdAt])
}

model KnowledgeRelation {
  id           String        @id @default(cuid())
  sourceId     String
  targetId     String
  relationType String
  strength     Float         @default(1)
  createdAt    DateTime      @default(now())
  source       KnowledgeItem @relation("KnowledgeRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KnowledgeItem @relation("KnowledgeRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, createdAt])
  @@index([targetId, createdAt])
}

model AgentKnowledgePreference {
  id              String        @id @default(cuid())
  agentId         String
  knowledgeId     String
  preferenceScore Float         @default(0)
  context         String?
  createdAt       DateTime      @default(now())
  knowledge       KnowledgeItem @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([agentId, knowledgeId, context])
  @@index([agentId, createdAt])
}

model KnowledgeOperationLog {
  id            String   @id @default(cuid())
  operationType String
  scope         String?
  projectId     String?
  agentId       String?
  triggeredBy   String?
  summary       String
  payload       Json
  canRollback   Boolean  @default(false)
  rolledBackAt  DateTime?
  createdAt     DateTime @default(now())

  @@index([operationType, createdAt])
  @@index([projectId, createdAt])
  @@index([agentId, createdAt])
  @@index([createdAt])
}

model HermesSkill {
  id             String   @id @default(cuid())
  hermesSkillId  String?  @unique
  skillKey       String   @unique
  name           String
  instruction    String
  type           String
  manifest       Json
  sourceProjectId String?
  source         String   @default("hermes")
  isCertified    Boolean  @default(true)
  isActive       Boolean  @default(true)
  usageCount     Int      @default(0)
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceProjectId, isCertified, updatedAt])
  @@index([skillKey, isActive])
}

model WorkflowTemplate {
  id                 String     @id @default(cuid())
  name               String
  key                String     @unique
  description        String?
  category           String
  isStandalone       Boolean    @default(false)
  standaloneCategory String?
  executorConfig     Json
  inputSchema        Json
  outputSchema       Json
  inputContract      Json?
  outputContract     Json?
  acceptanceCriteria Json?
  integrationConfig  Json?
  defaultTimeout     Int?
  allowParallel      Boolean    @default(false)
  stageTasks         Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  workflows          Workflow[]
}

model Workflow {
  id              String               @id @default(cuid())
  projectId       String
  templateId      String
  name            String
  stageGraph      Json
  status          String               @default("draft")
  currentStageIds Json
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template        WorkflowTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  stages          WorkflowStage[]
  transitions     WorkflowTransition[]

  @@index([projectId, status, createdAt])
}

model ProjectInput {
  id                   String           @id @default(cuid())
  projectId            String
  name                 String
  type                 String
  description          String?
  content              String?
  filePath             String?
  referenceDeliverableId String?
  validationStatus     String           @default("pending")
  validationErrors     Json?
  inputSource          String           @default("manual")
  createdAt            DateTime         @default(now())
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceDeliverable Deliverable?     @relation(fields: [referenceDeliverableId], references: [id], onDelete: SetNull)
  relayRelations       StageRelayRelation[] @relation("RelayTargetInput")

  @@index([projectId, createdAt])
  @@index([referenceDeliverableId])
}

model StageRelayRelation {
  id                  String       @id @default(cuid())
  sourceProjectId     String
  sourceStageId       String?
  sourceDeliverableIds Json
  targetProjectId     String
  targetInputId       String?
  relayType           String       @default("full")
  transformationConfig Json?
  syncStatus          String       @default("active")
  lastSyncAt          DateTime?
  createdAt           DateTime     @default(now())
  sourceProject       Project      @relation("RelaySourceProject", fields: [sourceProjectId], references: [id], onDelete: Cascade)
  sourceStage         Stage?       @relation("RelaySourceStage", fields: [sourceStageId], references: [id], onDelete: SetNull)
  targetProject       Project      @relation("RelayTargetProject", fields: [targetProjectId], references: [id], onDelete: Cascade)
  targetInput         ProjectInput? @relation("RelayTargetInput", fields: [targetInputId], references: [id], onDelete: SetNull)

  @@unique([sourceProjectId, sourceStageId, targetProjectId])
  @@index([sourceProjectId, sourceStageId, createdAt])
  @@index([targetProjectId, createdAt])
}

model WorkflowStage {
  id               String    @id @default(cuid())
  workflowId       String
  nodeId           String
  templateKey      String
  status           String    @default("pending")
  assignedAgents   Json
  inputArtifacts   Json
  outputArtifacts  Json
  startedAt        DateTime?
  completedAt      DateTime?
  deadline         DateTime?
  gateResults      Json?
  contextMemoryIds Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workflow         Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeId])
  @@index([workflowId, status, createdAt])
}

model WorkflowTransition {
  id          String    @id @default(cuid())
  workflowId  String
  fromStageId String?
  toStageId   String?
  action      String
  triggeredBy String
  reason      String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
}
