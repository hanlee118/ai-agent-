{
  "name": "@occ/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:routes": "tsx --test src/routes/routes.test.ts",
    "test:workflow-v2": "tsx --test src/workflow-v2/agent-assignment.test.ts src/workflow-v2/quality-gate.test.ts src/workflow-v2/hermes-mcp.test.ts src/data/repository-workflow-v2-link.test.ts src/routes/workflows-v2-schema-guard.test.ts src/routes/workflows-v2.test.ts src/routes/workflows-v2-hermes.test.ts src/routes/knowledge-v2.test.ts src/routes/skills-v2.test.ts src/routes/agents-hermes.test.ts src/routes/issues-workflow-link.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "tsx scripts/sqlite-migrate.ts deploy",
    "db:migrate:status": "tsx scripts/sqlite-migrate.ts status",
    "db:bootstrap": "sqlite3 prisma/dev.db < prisma/bootstrap.sql",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:workflow-v2": "tsx ../../scripts/seed-workflow-templates-v2.ts"
  },
  "dependencies": {
    "@google/stitch-sdk": "^0.1.0",
    "@occ/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.4",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.6.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
