{
  "name": "@occ/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:bootstrap": "sqlite3 prisma/dev.db < prisma/bootstrap.sql",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@occ/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.1",
    "prisma": "^6.6.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
