DATABASE_URL="postgresql://occ:occ@127.0.0.1:5432/occ?schema=public"
# API 测试默认使用 PostgreSQL 独立 schema（api_test），可按需覆盖:
TEST_DATABASE_URL="postgresql://occ:occ@127.0.0.1:5432/occ?schema=api_test"
ALLOW_SQLITE_URL_IN_TESTS="false"
MODEL_PROVIDER="scripted"
MODEL_API_BASE_URL=""
MODEL_API_KEY=""
MODEL_NAME=""
RATE_LIMIT_MAX="5000"
ISSUE_DEBATE_STALE_TIMEOUT_MS="90000"
# 预备阶段是否强制检测“真实模型回合”；本地联调建议 false，生产可按需开启 true
PREP_DISCUSSION_ENFORCE_MODEL_ROUND="false"
DESIGN_STITCH_MODE="required"
STITCH_API_KEY=""
STITCH_BASE_URL="https://stitch.googleapis.com/mcp"
STITCH_REQUEST_TIMEOUT_MS="180000"
# Stitch 代理策略: auto(优先系统代理失败后直连) | proxy_only | direct_only
STITCH_PROXY_STRATEGY="auto"
WORKFLOW_V2_HERMES_ENABLED="false"
WORKFLOW_V2_HERMES_STAGE_MATCH="design"
# Workflow-v2 Hermes MCP endpoint.
# Supports base URL (e.g. http://127.0.0.1:3001); runtime will normalize to /mcp/execute.
# Falls back to HERMES_MCP_ENDPOINT / HERMES_MCP when empty.
WORKFLOW_V2_HERMES_ENDPOINT=""
WORKFLOW_V2_HERMES_REQUIRED="false"
WORKFLOW_V2_HERMES_TIMEOUT_MS="20000"
# Project-stage fail-closed switch:
# when true, Hermes-required stages fail instead of silently downgrading.
PROJECT_STAGE_HERMES_REQUIRED="false"
HERMES_MCP_ENDPOINT=""
HERMES_MCP_API_KEY=""
HERMES_API_KEY=""
PROJECT_PARSE_LEGACY_ENABLED="false"
GITLAB_BASE_URL="https://gitlab.com"
GITLAB_TOKEN=""
GITLAB_DEFAULT_PROJECT=""
GITLAB_DEFAULT_PROJECT_ID=""
GITLAB_WEBHOOK_SECRET=""
# If GitLab runs in Docker, the project webhook URL must target the host-reachable
# API address, for example: http://host.docker.internal:8787/api/gitlab/webhook
# Do not use http://127.0.0.1:8787 inside the GitLab container.
OPENCLAW_ROOT=""
OPENCLAW_CONFIG_PATH=""
OPENCLAW_WORKSPACE_ROOT=""
CODEX_SESSIONS_ROOT=""
CLAUDE_PROJECTS_ROOT=""
OPENCLAW_AGENT_ROOT=""
APP_SECRET=""
ADMIN_EMAIL="admin@occ.local"
ADMIN_NAME="System Admin"
# 真实模型门禁：生产建议 true；本地/测试可 false 以保障全流程可跑通
ENFORCE_REAL_MODEL_GATE="false"
# 自动推进阶段是否强制真实模型门禁
ENFORCE_AUTO_STAGE_REAL_MODEL_GATE="false"
