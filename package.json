{
  "name": "occ-workspace",
  "private": true,
  "version": "1.0.3",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:web": "pnpm --filter @occ/web dev",
    "dev:api": "pnpm --filter @occ/api dev",
    "release:local": "./scripts/release-local.sh",
    "start:prod": "./scripts/start-local-prod.sh",
    "backup:local": "./scripts/backup-local.sh",
    "verify:local": "node scripts/verify-local.mjs",
    "audit:single-project": "node scripts/audit-single-project-platform.mjs",
    "audit:single-project:strict": "AUDIT_STRICT=true node scripts/audit-single-project-platform.mjs",
    "verify:single-project:full": "pnpm health:check && pnpm audit:single-project:strict",
    "verify:smoke": "bash scripts/verify-smoke.sh",
    "gitlab:webhook:check": "node scripts/gitlab-webhook-doctor.mjs",
    "gitlab:webhook:fix": "node scripts/gitlab-webhook-doctor.mjs --fix",
    "verify:real-data:round2": "node scripts/verify-real-data-round2.mjs",
    "verify:repeatable:018": "node scripts/verify-repeatable-018.mjs",
    "verify:platform:3rounds": "node scripts/verify-platform-3rounds.mjs",
    "verify:ui:e2e:3rounds": "node scripts/verify-ui-e2e-3rounds.mjs",
    "test:ui:workflow-template": "pnpm dlx playwright test scripts/e2e/ui-workflow-template.spec.ts --workers=1 --reporter=line",
    "verify:closure": "node --input-type=module -e \"import('./scripts/verify-closure.mjs')\"",
    "verify:closure:fast": "CLOSURE_FAST_PROJECT_FLOW_SCRIPTED=true CLOSURE_ENABLE_OPTIONAL_HEAVY_CHECKS=false node --input-type=module -e \"import('./scripts/verify-closure.mjs')\"",
    "verify:closure:full": "CLOSURE_FAST_PROJECT_FLOW_SCRIPTED=false CLOSURE_ENABLE_OPTIONAL_HEAVY_CHECKS=true node --input-type=module -e \"import('./scripts/verify-closure.mjs')\"",
    "sync:agent-governance": "pnpm --filter @occ/api exec tsx ../../scripts/sync-agent-governance.ts",
    "verify:task-delegation": "pnpm --filter @occ/api exec tsx ../../scripts/verify-task-delegation.ts",
    "verify:task-delegation:migration": "pnpm --filter @occ/api exec tsx ../../scripts/verify-task-delegation-migration.ts",
    "playbook:validate": "node scripts/validate-playbook.mjs --input templates/playbooks/projectroom-to-agentcommander-rollout.playbook.json",
    "playbook:materialize:projectroom-split": "node scripts/materialize-playbook-issue.mjs --input templates/playbooks/projectroom-to-agentcommander-rollout.playbook.json --issue-id projectroom-minimal-no-behavior-split",
    "test:smoke": "pnpm verify:local && pnpm verify:smoke",
    "test:acceptance": "pnpm verify:local && pnpm verify:smoke && pnpm verify:closure",
    "daemon:start": "./scripts/daemon-start.sh",
    "daemon:stop": "./scripts/daemon-stop.sh",
    "daemon:status": "./scripts/daemon-status.sh",
    "hermes:daemon:start": "./scripts/hermes-daemon-start.sh",
    "hermes:daemon:stop": "./scripts/hermes-daemon-stop.sh",
    "hermes:daemon:status": "./scripts/hermes-daemon-status.sh",
    "web:daemon:start": "./scripts/web-daemon-start.sh",
    "web:daemon:stop": "./scripts/web-daemon-stop.sh",
    "web:daemon:status": "./scripts/web-daemon-status.sh",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "gen:api-types": "node scripts/generate-api-types.mjs",
    "gen:api-types:web": "OPENAPI_TYPES_OUT=apps/web/src/lib/api/openapi.generated.ts node scripts/generate-api-types.mjs",
    "db:baseline": "node scripts/prisma-baseline.mjs",
    "db:baseline:apply": "node scripts/prisma-baseline.mjs --mark-applied",
    "db:seed:workflow-v2": "pnpm --filter @occ/api db:migrate:deploy && pnpm --filter @occ/api exec tsx ../../scripts/seed-workflow-templates-v2.ts",
    "health:check": "node scripts/health-check.mjs"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
